# Required. Shared secret your bot sends in the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Required. Epic OAuth clients as base64 "client_id:client_secret".
# Values: https://github.com/MixV2/EpicResearch/blob/main/docs/auth/auth_clients.md
# Nintendo Switch client: creates the device code
EPIC_SWITCH_CLIENT=
# fortniteIOSGameClient: the token used to read the account
EPIC_IOS_CLIENT=
# fortnitePCGameClient: EOS Connect token for /equipped
EPIC_EOS_CLIENT=

# Optional. How often the fortnite-api.com catalog is reloaded (seconds). Default: 21600 (6 h).
CATALOG_REFRESH_SECONDS=21600

