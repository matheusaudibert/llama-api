{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Llama API",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A78BFA",
    "dark": "#6D28D9"
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "favicon": "/llama-api.png",
  "contextual": {
    "options": ["copy", "claude", "chatgpt"]
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "tabs": [
          {
            "tab": "API Reference",
            "groups": [
              {
                "group": "Overview",
                "pages": ["api-reference/introduction"]
              },
              {
                "group": "Endpoints",
                "openapi": {
                  "source": "openapi.json",
                  "directory": "api-reference/endpoints"
                },
                "pages": [
                  "POST /auth/device",
                  "GET /auth/{session_id}",
                  "DELETE /auth/{session_id}",
                  "GET /accounts/{session_id}/summary",
                  "GET /accounts/{session_id}/locker",
                  "GET /accounts/{session_id}/equipped",
                  "POST /render/{category}",
                  "GET /backgrounds/{name}.png",
                  "GET /health"
                ]
              }
            ]
          },
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Getting started",
                "pages": ["guides/introduction", "quickstart"]
              },
              {
                "group": "Concepts",
                "pages": ["guides/login-flow", "guides/locker", "guides/errors"]
              },
              {
                "group": "Integration",
                "pages": ["guides/discord-bot"]
              }
            ]
          },
          {
            "tab": "Self-hosting",
            "groups": [
              {
                "group": "Deploy",
                "pages": ["self-hosting/production", "self-hosting/local"]
              }
            ]
          }
        ]
      },
      {
        "language": "pt-BR",
        "tabs": [
          {
            "tab": "Referência da API",
            "groups": [
              {
                "group": "Visão geral",
                "pages": ["pt-BR/api-reference/introduction"]
              },
              {
                "group": "Endpoints",
                "openapi": {
                  "source": "pt-BR/openapi.json",
                  "directory": "pt-BR/api-reference/endpoints"
                },
                "pages": [
                  "POST /auth/device",
                  "GET /auth/{session_id}",
                  "DELETE /auth/{session_id}",
                  "GET /accounts/{session_id}/summary",
                  "GET /accounts/{session_id}/locker",
                  "GET /accounts/{session_id}/equipped",
                  "POST /render/{category}",
                  "GET /backgrounds/{name}.png",
                  "GET /health"
                ]
              }
            ]
          },
          {
            "tab": "Guias",
            "groups": [
              {
                "group": "Começando",
                "pages": ["pt-BR/guides/introduction", "pt-BR/quickstart"]
              },
              {
                "group": "Conceitos",
                "pages": ["pt-BR/guides/login-flow", "pt-BR/guides/locker", "pt-BR/guides/errors"]
              },
              {
                "group": "Integração",
                "pages": ["pt-BR/guides/discord-bot"]
              }
            ]
          },
          {
            "tab": "Self-hosting",
            "groups": [
              {
                "group": "Deploy",
                "pages": ["pt-BR/self-hosting/production", "pt-BR/self-hosting/local"]
              }
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    { "source": "/deploy/producao", "destination": "/self-hosting/production" },
    { "source": "/deploy/coolify", "destination": "/self-hosting/production" },
    { "source": "/deploy/local", "destination": "/self-hosting/local" }
  ],
  "api": {
    "playground": {
      "display": "interactive"
    }
  }
}
