{
  "openapi": "3.1.0",
  "info": {
    "title": "Llama API",
    "description": "Logs in to an Epic Games account with the device code flow and reads the Fortnite data.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Does not require an API key. Use it as your host's healthcheck.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/auth/device": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Start login",
        "description": "Creates an Epic device code and waits for the authorization in the background. Show `verification_url` to the player.",
        "operationId": "start_device_login_auth_device_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceLoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Could not create the Epic device code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/auth/{session_id}": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login status",
        "description": "Poll every ~3 s until the status leaves `pending`.",
        "operationId": "login_status_auth__session_id__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Session not found or already removed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Authentication"
        ],
        "summary": "End session",
        "description": "Revokes the Epic token and deletes the session from memory.",
        "operationId": "logout_auth__session_id__delete",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Session not found or already removed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{session_id}/summary": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Account summary",
        "description": "Epic account data, V-Bucks, connected platforms and Battle Royale stats.",
        "operationId": "account_summary_accounts__session_id__summary_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountSummary"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Session not found or already removed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Login not completed (pending, expired or error)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Epic token expired, start a new login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Epic Games returned an error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{session_id}/locker": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Locker",
        "description": "Every cosmetic on the account, split by category and sorted by rarity.",
        "operationId": "account_locker_accounts__session_id__locker_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Locker"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Session not found or already removed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Login not completed (pending, expired or error)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Epic token expired, start a new login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Epic Games returned an error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{session_id}/equipped": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Equipped items",
        "description": "The items equipped in the player's active loadout: skin, backpack, pickaxe, glider, emotes, wraps and more. Saved presets are not included.",
        "operationId": "account_equipped_accounts__session_id__equipped_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Equipped"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Session not found or already removed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Login not completed (pending, expired or error)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Epic token expired, start a new login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Epic Games returned an error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/render/{category}": {
      "post": {
        "tags": [
          "Images"
        ],
        "summary": "Locker image",
        "description": "Renders a PNG with the items of one category, in skin checker style. `mythics` gathers the mythic items of every category. No session needed: send the items saved from `/locker`.",
        "operationId": "render_locker_render__category__post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "category",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RenderCategory"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PNG with the items of the category",
            "content": {
              "image/png": {}
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "No item of the category in the list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountSummary": {
        "properties": {
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "Unmasked email. Mask it before showing it in public channels."
          },
          "email_verified": {
            "type": "boolean",
            "title": "Email Verified"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "last_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Name"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country",
            "description": "Country code (ISO 3166-1 alpha-2)."
          },
          "tfa_enabled": {
            "type": "boolean",
            "title": "Tfa Enabled",
            "description": "Whether two-factor authentication is on."
          },
          "minor_verified": {
            "type": "boolean",
            "title": "Minor Verified",
            "description": "Whether the account has parental controls / minor verification."
          },
          "account_created": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Created",
            "description": "Epic account creation date (ISO 8601)."
          },
          "profile_created": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profile Created",
            "description": "Fortnite profile creation date (ISO 8601)."
          },
          "last_login": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Login",
            "description": "Last login to the Epic account (ISO 8601)."
          },
          "can_change_display_name": {
            "type": "boolean",
            "title": "Can Change Display Name",
            "description": "Whether the display name can be changed right now."
          },
          "display_name_changes": {
            "type": "integer",
            "title": "Display Name Changes",
            "description": "How many times the display name was changed."
          },
          "last_display_name_change": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Display Name Change",
            "description": "Last display name change (ISO 8601)."
          },
          "vbucks": {
            "type": "integer",
            "title": "Vbucks",
            "description": "Total V-Bucks across all sources."
          },
          "vbucks_by_platform": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Vbucks By Platform",
            "description": "V-Bucks per platform, e.g. {\"Shared\": 100, \"PSN\": 3300}. Platform V-Bucks can only be spent on that platform."
          },
          "mtx_platform": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mtx Platform",
            "description": "Platform the V-Bucks purchases are tied to, e.g. EpicPC, PSN, Live."
          },
          "refund_credits": {
            "type": "integer",
            "title": "Refund Credits",
            "description": "Refund tickets left."
          },
          "refunds_used": {
            "type": "integer",
            "title": "Refunds Used",
            "description": "Refund tickets already used."
          },
          "external_auths": {
            "items": {
              "$ref": "#/components/schemas/ExternalAuth"
            },
            "type": "array",
            "title": "External Auths",
            "description": "Platforms connected to the account."
          },
          "linkable_platforms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Linkable Platforms",
            "description": "Consoles (psn, xbl, nintendo) not linked to the account, which a new owner can link."
          },
          "account_level": {
            "type": "integer",
            "title": "Account Level"
          },
          "lifetime_wins": {
            "type": "integer",
            "title": "Lifetime Wins",
            "description": "Wins over the whole account, current season included."
          },
          "total_wins": {
            "type": "integer",
            "title": "Total Wins",
            "description": "Wins summed over all past seasons."
          },
          "total_matches": {
            "type": "integer",
            "title": "Total Matches",
            "description": "Matches summed over all past seasons."
          },
          "last_match_end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Match End",
            "description": "End of the last match played (ISO 8601)."
          },
          "current_season": {
            "$ref": "#/components/schemas/PastSeason",
            "description": "Current season: number, level, battle pass and wins."
          },
          "past_seasons": {
            "items": {
              "$ref": "#/components/schemas/PastSeason"
            },
            "type": "array",
            "title": "Past Seasons"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "display_name",
          "email_verified",
          "tfa_enabled",
          "minor_verified",
          "can_change_display_name",
          "display_name_changes",
          "vbucks",
          "vbucks_by_platform",
          "refund_credits",
          "refunds_used",
          "external_auths",
          "linkable_platforms",
          "account_level",
          "lifetime_wins",
          "total_wins",
          "total_matches",
          "current_season",
          "past_seasons"
        ],
        "title": "AccountSummary"
      },
      "Cosmetic": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Lowercase cosmetic ID, e.g. cid_028_athena_commando_f."
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Item name. Same as `id` when the item is not in the catalog."
          },
          "name_pt": {
            "type": "string",
            "title": "Name Pt",
            "description": "Item name in Brazilian Portuguese. Same as `name` when there is no translation yet."
          },
          "rarity": {
            "type": "string",
            "title": "Rarity",
            "description": "Common, Uncommon, Rare, Epic, Legendary, Mythic or a series, such as Icon Series."
          },
          "series": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Series",
            "description": "Item series, if any."
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type",
            "description": "Type on fortnite-api, e.g. outfit, backpack, pickaxe, emote, glider."
          },
          "images": {
            "$ref": "#/components/schemas/CosmeticImages"
          },
          "owned_styles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Owned Styles",
            "description": "Tags of the styles the player unlocked."
          },
          "is_exclusive": {
            "type": "boolean",
            "title": "Is Exclusive",
            "description": "Part of the exclusive items list (Renegade Raider, Ghoul Trooper…)."
          },
          "is_mythic": {
            "type": "boolean",
            "title": "Is Mythic",
            "description": "Rare/OG item: on the rare items list and out of the shop for 2 years, or with the original owners' exclusive style."
          },
          "in_catalog": {
            "type": "boolean",
            "title": "In Catalog",
            "description": "False when fortnite-api has no data for this item yet."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "name_pt",
          "rarity",
          "images",
          "owned_styles",
          "is_exclusive",
          "is_mythic",
          "in_catalog"
        ],
        "title": "Cosmetic"
      },
      "CosmeticImages": {
        "properties": {
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Icon"
          },
          "small_icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Small Icon"
          },
          "featured": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Featured"
          }
        },
        "type": "object",
        "title": "CosmeticImages"
      },
      "DeviceLoginResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "description": "Opaque ID used in every other call of this login."
          },
          "verification_url": {
            "type": "string",
            "title": "Verification Url",
            "description": "Epic Games page where the player authorizes the login."
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "description": "Seconds until the verification link expires."
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "verification_url",
          "expires_in"
        ],
        "title": "DeviceLoginResponse"
      },
      "Equipped": {
        "properties": {
          "skin": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EquippedCosmetic"
              },
              {
                "type": "null"
              }
            ]
          },
          "backpack": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EquippedCosmetic"
              },
              {
                "type": "null"
              }
            ]
          },
          "pickaxe": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EquippedCosmetic"
              },
              {
                "type": "null"
              }
            ]
          },
          "glider": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EquippedCosmetic"
              },
              {
                "type": "null"
              }
            ]
          },
          "contrail": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EquippedCosmetic"
              },
              {
                "type": "null"
              }
            ]
          },
          "shoes": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EquippedCosmetic"
              },
              {
                "type": "null"
              }
            ]
          },
