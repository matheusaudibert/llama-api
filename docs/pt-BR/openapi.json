{
  "openapi": "3.1.0",
  "info": {
    "title": "Llama API",
    "description": "Faz login numa conta Epic Games pelo device code flow e lê os dados do Fortnite.",
    "version": "1.0.0"
  },
  "paths": {
    "/backgrounds/{name}.png": {
      "get": {
        "tags": [
          "Imagens"
        ],
        "summary": "Fundo da raridade",
        "description": "O quadrado desenhado atrás de um item dessa raridade, como no link de `images.background`. Não exige API key.",
        "operationId": "rarity_background_backgrounds__name__png_get",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PNG do fundo da raridade",
            "content": {
              "image/png": {}
            }
          },
          "404": {
            "description": "Fundo de raridade desconhecido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Erro de validação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Não exige API key. Use no healthcheck da hospedagem.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Resposta de sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/auth/device": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Iniciar login",
        "description": "Cria um device code na Epic e começa a esperar a autorização em background. Mostre `verification_url` ao jogador.",
        "operationId": "start_device_login_auth_device_post",
        "responses": {
          "200": {
            "description": "Resposta de sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceLoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "API key ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Não foi possível criar o device code na Epic",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/auth/{session_id}": {
      "get": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Status do login",
        "description": "Consulte a cada ~3 s até o status sair de `pending`.",
        "operationId": "login_status_auth__session_id__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resposta de sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "API key ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Sessão não encontrada ou já removida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Erro de validação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Encerrar sessão",
        "description": "Invalida o token na Epic e apaga a sessão da memória.",
        "operationId": "logout_auth__session_id__delete",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Resposta de sucesso"
          },
          "401": {
            "description": "API key ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Sessão não encontrada ou já removida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Erro de validação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{session_id}/summary": {
      "get": {
        "tags": [
          "Conta"
        ],
        "summary": "Resumo da conta",
        "description": "Dados da conta Epic, V-Bucks, plataformas conectadas e estatísticas do Battle Royale.",
        "operationId": "account_summary_accounts__session_id__summary_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resposta de sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountSummary"
                }
              }
            }
          },
          "401": {
            "description": "API key ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Sessão não encontrada ou já removida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Login não concluído (pending, expired ou error)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Token da Epic expirou, inicie um novo login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "A Epic Games retornou um erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Erro de validação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{session_id}/locker": {
      "get": {
        "tags": [
          "Conta"
        ],
        "summary": "Locker",
        "description": "Todos os cosméticos da conta, separados por categoria e ordenados por raridade.",
        "operationId": "account_locker_accounts__session_id__locker_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resposta de sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Locker"
                }
              }
            }
          },
          "401": {
            "description": "API key ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Sessão não encontrada ou já removida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Login não concluído (pending, expired ou error)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Token da Epic expirou, inicie um novo login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "A Epic Games retornou um erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Erro de validação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{session_id}/equipped": {
      "get": {
        "tags": [
          "Conta"
        ],
        "summary": "Itens equipados",
        "description": "Os itens equipados no visual ativo do jogador: skin, mochila, picareta, asa-delta, emotes, envelopamentos e mais. Os presets salvos não entram.",
        "operationId": "account_equipped_accounts__session_id__equipped_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resposta de sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Equipped"
                }
              }
            }
          },
          "401": {
            "description": "API key ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Sessão não encontrada ou já removida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Login não concluído (pending, expired ou error)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Token da Epic expirou, inicie um novo login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "A Epic Games retornou um erro",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Erro de validação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/render/{category}": {
      "post": {
        "tags": [
          "Imagens"
        ],
        "summary": "Imagem do locker",
        "description": "Gera um PNG com os itens de uma categoria, no estilo dos checkers. `mythics` junta os itens míticos de todas as categorias. Não exige sessão: envie os itens salvos do `/locker`.",
        "operationId": "render_locker_render__category__post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "category",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RenderCategory"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PNG com os itens da categoria",
            "content": {
              "image/png": {}
            }
          },
          "401": {
            "description": "API key ausente ou inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Nenhum item da categoria na lista enviada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountSummary": {
        "properties": {
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "Email sem máscara. Mascare antes de exibir em canais públicos."
          },
          "email_verified": {
            "type": "boolean",
            "title": "Email Verified"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "last_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Name"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country",
            "description": "Código do país (ISO 3166-1 alpha-2)."
          },
          "tfa_enabled": {
            "type": "boolean",
            "title": "Tfa Enabled",
            "description": "Se a autenticação de dois fatores está ativa."
          },
          "minor_verified": {
            "type": "boolean",
            "title": "Minor Verified",
            "description": "Se a conta tem controle parental / verificação de menor."
          },
          "account_created": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Created",
            "description": "Criação da conta Epic (ISO 8601)."
          },
          "profile_created": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profile Created",
            "description": "Criação do perfil no Fortnite (ISO 8601)."
          },
          "last_login": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Login",
            "description": "Último login na conta Epic (ISO 8601)."
          },
          "can_change_display_name": {
            "type": "boolean",
            "title": "Can Change Display Name",
            "description": "Se o nick pode ser trocado agora."
          },
          "display_name_changes": {
            "type": "integer",
            "title": "Display Name Changes",
            "description": "Quantas vezes o nick já foi trocado."
          },
          "last_display_name_change": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Display Name Change",
            "description": "Data da última troca de nick (ISO 8601)."
          },
          "can_change_email": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Can Change Email",
            "description": "Se o email pode ser trocado agora. Nulo quando a Epic não respondeu."
          },
          "last_email_change": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Email Change",
            "description": "Data da última troca de email (ISO 8601)."
          },
          "email_change_available_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email Change Available At",
            "description": "Quando um email bloqueado poderá ser trocado de novo (ISO 8601). Nulo quando já pode ser trocado."
          },
          "vbucks": {
            "type": "integer",
            "title": "Vbucks",
            "description": "Total de V-Bucks somando todas as fontes."
          },
          "vbucks_by_platform": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Vbucks By Platform",
            "description": "V-Bucks por plataforma, ex: {\"Shared\": 100, \"PSN\": 3300}. V-Bucks de uma plataforma só podem ser gastos nela."
          },
          "mtx_platform": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mtx Platform",
            "description": "Plataforma a que as compras de V-Bucks estão vinculadas, ex: EpicPC, PSN, Live."
          },
          "refund_credits": {
            "type": "integer",
            "title": "Refund Credits",
            "description": "Créditos de reembolso restantes."
          },
          "refunds_used": {
            "type": "integer",
            "title": "Refunds Used",
            "description": "Créditos de reembolso já usados."
          },
          "external_auths": {
            "items": {
              "$ref": "#/components/schemas/ExternalAuth"
            },
            "type": "array",
            "title": "External Auths",
            "description": "Todas as plataformas e provedores de login vinculados à conta, como a Epic informa (psn, xbl, nintendo, steam, github, twitch, google, apple…)."
          },
          "linkable_platforms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Linkable Platforms",
            "description": "Plataformas que podem ser vinculadas no epicgames.com (psn, xbl, nintendo, steam, github, twitch) e ainda não estão vinculadas à conta, então um novo dono pode vinculá-las."
          },
          "account_level": {
            "type": "integer",
            "title": "Account Level"
          },
          "lifetime_wins": {
            "type": "integer",
            "title": "Lifetime Wins",
            "description": "Vitórias da conta inteira, incluindo a temporada atual."
          },
          "total_wins": {
            "type": "integer",
            "title": "Total Wins",
            "description": "Soma das vitórias de todas as temporadas passadas."
          },
          "total_matches": {
            "type": "integer",
            "title": "Total Matches",
            "description": "Soma das partidas de todas as temporadas passadas."
          },
          "last_match_end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Match End",
            "description": "Fim da última partida jogada (ISO 8601)."
          },
          "current_season": {
            "$ref": "#/components/schemas/PastSeason",
            "description": "Temporada atual: número, nível, passe de batalha e vitórias."
          },
          "past_seasons": {
            "items": {
              "$ref": "#/components/schemas/PastSeason"
            },
            "type": "array",
            "title": "Past Seasons"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "display_name",
          "email_verified",
          "tfa_enabled",
          "minor_verified",
          "can_change_display_name",
          "display_name_changes",
          "vbucks",
          "vbucks_by_platform",
          "refund_credits",
          "refunds_used",
          "external_auths",
          "linkable_platforms",
          "account_level",
          "lifetime_wins",
          "total_wins",
          "total_matches",
          "current_season",
          "past_seasons"
        ],
        "title": "AccountSummary"
      },
      "Cosmetic": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "ID do cosmético em minúsculas, ex: cid_028_athena_commando_f."
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Nome do item. Igual ao `id` quando o item não está no catálogo."
          },
          "name_pt": {
            "type": "string",
            "title": "Name Pt",
            "description": "Nome do item em português do Brasil. Igual ao `name` quando ainda não há tradução."
          },
          "rarity": {
            "type": "string",
            "title": "Rarity",
            "description": "Common, Uncommon, Rare, Epic, Legendary, Mythic ou uma série, como Icon Series."
          },
          "series": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Series",
            "description": "Série do item, quando houver."
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type",
            "description": "Tipo no fortnite-api, ex: outfit, backpack, pickaxe, emote, glider."
          },
          "images": {
            "$ref": "#/components/schemas/CosmeticImages"
          },
          "owned_styles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Owned Styles",
            "description": "Tags dos estilos que o jogador desbloqueou."
          },
          "is_exclusive": {
            "type": "boolean",
            "title": "Is Exclusive",
